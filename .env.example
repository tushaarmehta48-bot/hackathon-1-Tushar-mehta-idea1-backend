# HTTP server (default 3001 so Next.js can use 3000)
PORT=3001

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Supabase (required from Phase 3 for live DB tests; Phase 4 for API auth)
# Project URL — same value as NEXT_PUBLIC_SUPABASE_URL on the frontend
# Project URL (no /rest/v1 suffix) — same host as NEXT_PUBLIC_SUPABASE_URL on the frontend
SUPABASE_URL=
# service_role JWT only (Project Settings → API → service_role). Never paste NEXT_PUBLIC_SUPABASE_ANON_KEY here.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres URI — required once for npm run db:apply (Dashboard → Settings → Database → URI)
# Replace [YOUR-PASSWORD] with your project database password (not the anon/service JWT keys).
DATABASE_URL=

# Staff / admin portal sign-in (unique IDs + passwords; synced to Supabase on backend start)
STAFF_PORTAL_USER_ID=
STAFF_PORTAL_PASSWORD=
STAFF_PORTAL_EMAIL=
ADMIN_PORTAL_USER_ID=
ADMIN_PORTAL_PASSWORD=
ADMIN_PORTAL_EMAIL=

# Optional: NestJS Observe telemetry (https://observe.nestjs.com)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# Signed QR check-in passes (optional; derived from service role key if unset)
# QR_PASS_SECRET=

# Payments (Phase 8) — leave disabled until you integrate a gateway (Stripe, etc.)
PAYMENTS_ENABLED=false
# When PAYMENTS_ENABLED=true:
# PAYMENT_PROVIDER=dev
# PAYMENT_WEBHOOK_SECRET=change-me-for-local-webhook-tests
# FRONTEND_URL=http://localhost:3000
# PAYMENT_HOLD_EXPIRY_ENABLED=true
